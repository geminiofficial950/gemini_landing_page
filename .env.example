# Copy to .env (local) or add these in your hosting dashboard.

# ---- SMTP (Gmail: use an App Password, port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ---- MongoDB (leave empty to store leads in server/data/leads.json)
MONGO_URI=
# MONGO_DB=landing_page

# ---- Admin panel (/admin)
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Server
PORT=3000
MAIL_FROM_NAME=Gemini Education
# Where "new lead" alert emails go (empty = SMTP_USER)
ADMIN_NOTIFY_EMAIL=
# Set to 1 when running behind a hosting proxy (Render/Railway/Nginx)
# TRUST_PROXY=1
